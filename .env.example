DISCORD_TOKEN=
DISCORD_APP_ID=

# Optional. Registers commands to a single guild (instant) instead of globally (up to 1h).
DISCORD_DEV_GUILD_ID=

# Optional. User IDs that may always use /pickup-config, regardless of server permissions.
# One ID, or several separated by commas.
POWER_USER_IDS=

# Public address of the bot's own web server, used for the iCal button.
# Leave blank to run no web server and show only the Google Calendar button.
# Must be reachable from members' devices, so not localhost in production.
PUBLIC_BASE_URL=
HTTP_PORT=18080

# Key for the HenrikDev Valorant API (https://api.henrikdev.xyz), used by
# /valo-account and /valo-api. Leave blank to turn those commands off; the rest
# of the bot runs without it.
VALORANT_API_KEY=

# Requests per minute your key is allowed. A basic key gets 30.
VALORANT_RATE_LIMIT_PER_MINUTE=30

# Optional. Serves an API playground at
#   <PUBLIC_BASE_URL>/pickup/<this value>/valorant-playground
# Blank = no playground. The URL is the only thing guarding it, so use something
# long and random: `openssl rand -hex 24`. Needs PUBLIC_BASE_URL and an API key.
VALORANT_PLAYGROUND_SECRET=

# Appends one JSON line per slash command and button click, each listing the
# Valorant API requests it caused. Blank records nothing. Under Docker this is set
# to /audit/audit.log, inside a directory bind-mounted from the host.
AUDIT_LOG_PATH=

DATABASE_PATH=./data/pickup.db
HEARTBEAT_PATH=/tmp/heartbeat
LOG_LEVEL=info
NODE_ENV=production
