{
  "name": "discord-pickup-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "deploy": "node --env-file=.env src/scripts/deployCommands.ts",
    "gen:valorant:fetch": "curl -sf https://api.henrikdev.xyz/openapi.json -o src/valorant/generated/openapi.json",
    "gen:valorant": "npx -y openapi-typescript@7 src/valorant/generated/openapi.json -o src/valorant/generated/schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run coverage"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "jpeg-js": "0.4.4",
    "pino": "10.4.0",
    "pngjs": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "pino-pretty": "13.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
